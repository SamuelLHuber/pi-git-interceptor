{
  "name": "pi-git-interceptor",
  "version": "1.0.1",
  "scripts": { "check": "tsc --noEmit", "test": "node --test test/*.test.mjs" },
  "description": "Safety guardrails for git commands in pi — prevents editor hangs and blocks hook bypasses",
  "keywords": [
    "pi-package",
    "pi-extension",
    "git",
    "safety",
    "guardrails"
  ],
  "type": "module",
  "main": "index.ts",
  "files": [
    "index.ts",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@types/node": "22.20.5",
    "typescript": "6.0.3"
  }
}
